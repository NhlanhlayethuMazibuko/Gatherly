# Copy this file to .env and fill in your own values. Never commit .env.
# Find the Supabase values in your project: Project Settings > API.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Never put this in the Flutter apps.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Restrict this key to the Android and iOS app IDs in Google Cloud.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Where the Flutter apps find the API during development.
API_BASE_URL=http://localhost:5023
