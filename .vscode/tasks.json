{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/api/src/Gatherly.Api/Gatherly.Api.csproj"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "test api",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/api/Gatherly.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
